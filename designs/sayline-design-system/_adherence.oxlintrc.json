{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/core/**",
              "components/feedback/**",
              "components/learning/**",
              "components/navigation/**",
              "ui_kits/learner/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tone|key|ref|className|style)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: children, tone."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:neutral|action|success|warning)$/]",
        "message": "<Badge> tone must be one of 'neutral' | 'action' | 'success' | 'warning'."
      },
      {
        "selector": "JSXOpeningElement[name.name='BottomNav'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|onChange|key|ref|className|style|children)$/]",
        "message": "<BottomNav> doesn't accept that prop. Declared props: value, onChange."
      },
      {
        "selector": "JSXOpeningElement[name.name='BottomNav'] > JSXAttribute[name.name='value'] > Literal[value!=/^(?:home|me)$/]",
        "message": "<BottomNav> value must be one of 'home' | 'me'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|variant|size|fullWidth|loading|key|ref|className|style)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: children, variant, size, fullWidth, loading."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|accent|secondary|ghost|danger)$/]",
        "message": "<Button> variant must be one of 'primary' | 'accent' | 'secondary' | 'ghost' | 'danger'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CategoryCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|description|courseCount|coverUrl|colorA|colorB|className|key|ref|style|children)$/]",
        "message": "<CategoryCard> doesn't accept that prop. Declared props: title, description, courseCount, coverUrl, colorA, colorB, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='Checkbox'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|children|key|ref|className|style)$/]",
        "message": "<Checkbox> doesn't accept that prop. Declared props: id, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='CourseCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|meta|coverUrl|colorA|colorB|favorite|progress|duration|variant|onOpen|onToggleFavorite|className|key|ref|style|children)$/]",
        "message": "<CourseCard> doesn't accept that prop. Declared props: title, meta, coverUrl, colorA, colorB, favorite, progress, duration, variant, onOpen, onToggleFavorite, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='CourseCard'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:row|feed)$/]",
        "message": "<CourseCard> variant must be one of 'row' | 'feed'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Dialog'] > JSXAttribute > JSXIdentifier[name!=/^(?:open|eyebrow|title|description|children|actions|onClose|key|ref|className|style)$/]",
        "message": "<Dialog> doesn't accept that prop. Declared props: open, eyebrow, title, description, children, actions, onClose."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|strokeWidth|label|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, strokeWidth, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute[name.name='name'] > Literal[value!=/^(?:arrow-left|arrow-right|audio-lines|book-open|bookmark|calendar-days|captions|check|chevron-down|chevron-left|chevron-right|chevrons-down|chevrons-up|circle-check|clock-3|ellipsis|headphones|heart|home|image|lock-keyhole|log-in|log-out|mic|music-2|pause|pen-line|play|plus|rotate-ccw|rotate-cw|search|settings-2|skip-back|skip-forward|sparkles|square|trash-2|upload|user-round|volume-2|x)$/]",
        "message": "<Icon> name must be one of 'arrow-left' | 'arrow-right' | 'audio-lines' | 'book-open' | 'bookmark' | 'calendar-days' | 'captions' | 'check' | 'chevron-down' | 'chevron-left' | 'chevron-right' | 'chevrons-down' | 'chevrons-up' | 'circle-check' | 'clock-3' | 'ellipsis' | 'headphones' | 'heart' | 'home' | 'image' | 'lock-keyhole' | 'log-in' | 'log-out' | 'mic' | 'music-2' | 'pause' | 'pen-line' | 'play' | 'plus' | 'rotate-ccw' | 'rotate-cw' | 'search' | 'settings-2' | 'skip-back' | 'skip-forward' | 'sparkles' | 'square' | 'trash-2' | 'upload' | 'user-round' | 'volume-2' | 'x'."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|label|variant|active|key|ref|className|style)$/]",
        "message": "<IconButton> doesn't accept that prop. Declared props: children, label, variant, active."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:plain|outline)$/]",
        "message": "<IconButton> variant must be one of 'plain' | 'outline'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|label|hint|error|aside|key|ref|className|style|children)$/]",
        "message": "<Input> doesn't accept that prop. Declared props: id, label, hint, error, aside."
      },
      {
        "selector": "JSXOpeningElement[name.name='ModeSwitcher'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|onChange|iconOnly|key|ref|className|style|children)$/]",
        "message": "<ModeSwitcher> doesn't accept that prop. Declared props: value, onChange, iconOnly."
      },
      {
        "selector": "JSXOpeningElement[name.name='ModeSwitcher'] > JSXAttribute[name.name='value'] > Literal[value!=/^(?:listen|read|write|speak)$/]",
        "message": "<ModeSwitcher> value must be one of 'listen' | 'read' | 'write' | 'speak'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProgressBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|label|showValue|tone|className|key|ref|style|children)$/]",
        "message": "<ProgressBar> doesn't accept that prop. Declared props: value, label, showValue, tone, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProgressBar'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:action|moss|light)$/]",
        "message": "<ProgressBar> tone must be one of 'action' | 'moss' | 'light'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatTile'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|label|detail|className|key|ref|style|children)$/]",
        "message": "<StatTile> doesn't accept that prop. Declared props: value, label, detail, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tabs'] > JSXAttribute > JSXIdentifier[name!=/^(?:items|value|onChange|ariaLabel|variant|className|key|ref|style|children)$/]",
        "message": "<Tabs> doesn't accept that prop. Declared props: items, value, onChange, ariaLabel, variant, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tabs'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:underline|pill)$/]",
        "message": "<Tabs> variant must be one of 'underline' | 'pill'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Textarea'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|label|hint|error|aside|key|ref|className|style|children)$/]",
        "message": "<Textarea> doesn't accept that prop. Declared props: id, label, hint, error, aside."
      },
      {
        "selector": "JSXOpeningElement[name.name='Toast'] > JSXAttribute > JSXIdentifier[name!=/^(?:message|tone|action|onClose|key|ref|className|style|children)$/]",
        "message": "<Toast> doesn't accept that prop. Declared props: message, tone, action, onClose."
      },
      {
        "selector": "JSXOpeningElement[name.name='Toast'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:neutral|success|danger)$/]",
        "message": "<Toast> tone must be one of 'neutral' | 'success' | 'danger'."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
